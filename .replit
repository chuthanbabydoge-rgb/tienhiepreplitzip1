modules = ["web", "nodejs-20", "nix", "python-3.11"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true
integrations = ["javascript_gemini_ai_integrations:2.0.0", "javascript_log_in_with_replit:2.0.0"]
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Snapshot Watcher"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "App Summary Watcher"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Snapshot Watcher"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node generate-snapshot.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "App Summary Watcher"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node generate-app-summary.js"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80
